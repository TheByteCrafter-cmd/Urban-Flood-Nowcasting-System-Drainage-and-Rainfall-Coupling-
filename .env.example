# GeoNexus Environment Configuration Template
# Copy to .env for local overrides if needed

# Optional custom map style URL or tile specification
# Leave blank to use the default clean Esri World Light Gray Base map (zero API key required)
VITE_MAP_STYLE=

# Optional Backend API Base URL (For Phase 7 integration)
VITE_API_BASE_URL=http://localhost:8000/api/v1
